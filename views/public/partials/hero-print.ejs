<%
  /* „Spaustuvės“ temos pradinis ekranas: antraštė + atkurta Piktogramos vizitinė kortelė
     (50 × 90 mm, vertikali) ant spaudos lapo su kirpimo žymėmis ir CMYK juostele. */
  const tagWords = S('hero_tagline').replace(/[.!]$/, '').split(/\s+/);
  const tagLast = tagWords.pop();
  const tagEnd = (S('hero_tagline').match(/[.!]$/) || [''])[0];
  const sq = (cx, cy, s, cls) => `<rect class="${cls}" x="${cx - s / 2}" y="${cy - s / 2}" width="${s}" height="${s}" transform="rotate(45 ${cx} ${cy})"/>`;
  const cardContacts = [
    s.phone && { ico: 'phone', v: s.phone },
    s.phone2 && { ico: 'mobile', v: s.phone2 },
    (s.address || s.city) && { ico: 'pin', v: [s.address, s.city].filter(Boolean).join(', ') },
    s.email && { ico: 'mail', v: s.email },
  ].filter(Boolean);
%>
<section class="phero" id="top">
  <div class="container phero__grid">
    <div class="phero__copy">
      <p class="phero__meta"><span class="regmark" aria-hidden="true"></span><%= S('hero_overline') %></p>
      <h1 class="phero__title">
        <span class="sr-only"><%= siteName %> – </span>
        <%= tagWords.join(' ') %> <em><%= tagLast %></em><%= tagEnd %>
      </h1>
      <p class="phero__text"><%= S('hero_text') %></p>
      <div class="phero__actions">
        <a class="btn btn--primary btn--lg" href="#registracija"><%= t('hero.cta') %> <%- icon('arrow', 20) %></a>
        <% if (has.cardMaker) { %><a class="btn btn--ghost btn--lg" href="<%= paths.card %>"><%- icon('card', 20) %> <%= t('hero.cta2') %></a><% } %>
      </div>
      <dl class="phero__facts">
        <div><dt>1996</dt><dd><%= t('hero.facts1') %></dd></div>
        <div><dt><%= s.address || 'Kauno g. 4' %></dt><dd><%= s.city || t('hero.facts2') %></dd></div>
        <div><dt>1</dt><dd><%= t('hero.facts3') %></dd></div>
      </dl>
    </div>

    <div class="phero__sheet" aria-hidden="true">
      <div class="sheet">
        <i class="crop crop--tl"></i><i class="crop crop--tr"></i><i class="crop crop--bl"></i><i class="crop crop--br"></i>
        <span class="regmark sheet__reg sheet__reg--l"></span><span class="regmark sheet__reg sheet__reg--r"></span>
        <svg class="pcard" viewBox="0 0 500 900" focusable="false">
          <rect width="500" height="900" fill="#fff"/>
          <polygon points="0,0 432,0 500,112 0,598" fill="#121212"/>
          <text x="250" y="122" text-anchor="middle" class="pcard__name">PIKTOGRAMA</text>
          <text x="262" y="172" text-anchor="middle" class="pcard__script">reklamos paslaugos</text>
          <g class="pcard__sq">
            <%- sq(204, 340, 124, 'r') %><%- sq(196, 332, 124, 'g') %><%- sq(196, 332, 74, 'l') %>
            <%- sq(98, 332, 42, 'o') %><%- sq(250, 322, 42, 'og') %>
            <%- sq(104, 537, 148, 'gl') %><%- sq(114, 527, 148, 'r') %><%- sq(62, 474, 42, 'o') %>
            <%- sq(322, 214, 24, 'g') %><%- sq(318, 234, 24, 'o') %><%- sq(364, 204, 14, 'o') %><%- sq(386, 210, 9, 'r') %>
            <%- sq(340, 266, 34, 'w') %><%- sq(350, 256, 34, 'r') %><%- sq(446, 222, 30, 'r') %>
          </g>
          <% cardContacts.forEach((c, i) => { const y = 712 + i * 42; %>
          <g transform="translate(70 <%= y - 23 %>) scale(1.25)" class="pcard__ico"><%- icon(c.ico, 24).replace(/<svg[^>]*>|<\/svg>/g, '') %></g>
          <text x="116" y="<%= y %>" class="pcard__line"><%= c.v %></text>
          <% }) %>
        </svg>
        <div class="cmyk" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <p class="sheet__note"><%= t('hero.cardNote') %></p>
    </div>
  </div>
</section>
